{% extends "admin/layout/crud-layout.html.twig" %}

{% block title %}
	{{appName}}
	- Liste Factures
{% endblock %}

{% block page_content %}

	{# Filtre #}
	<div class="mt-2">
		<h5 class="font-size-14 mb-2">
			<i class="mdi mdi-arrow-right text-primary me-1"></i>
			Filtre <span class="text-danger">*</span> : </h5>

		<form class="row gx-3 gy-2 align-items-center filtre-form">
			<div class="row mb-3 mt-3">
				<div class="col-lg-3 col-md-3 col-sm-3 mb-sm-0 mb-2">
					<label class="form-label font-size-13 text-muted" for="date-debut">Début</label>
					<input type="datetime-local" class="form-control" id="date-debut" name="date-debut" placeholder="" value="" step=1>
				</div>
				<div class="col-lg-3 col-md-3 col-sm-3 mb-sm-0 mb-2">
					<label class="form-label font-size-13 text-muted" for="date-fin">Fin</label>
					<input type="datetime-local" class="form-control" id="date-fin" name="date-fin" placeholder="" value="" step=1>
				</div>
				<div class="col-sm-6 mt-sm-4 mt-2 mb-sm-0 mb-2">
					<div class="row">						
						<div class="d-flex flex-wrap justify-content-between justify-content-center">
							<button type="submit" class="btn btn-primary" style="margin-top: 5px;">
								<i class="bx bx-mail-send align-middle"></i>
								<span class="d-sm-none">Envoyer</span>
							</button>
						</div>							
					</div>					
				</div>
			</div>
		</form>
	</div>
	<br>
	{# End Filtre #}

{% endblock %}

{% block page_custom_scripts %}
	<script>
		const URL_SEND_MARGE_BENEFICIAIRE_BY_DATE = "{{ url_send_marge_beneficiaire_by_date }}";
		const URL_PRINT_DEPENSE_BY_DATE = "{{ url_print_rapport_depense_by_date }}";
		const URL_PRINT_BENEFICE_BY_DATE = "{{ url_print_rapport_benefice_by_date }}";
	</script>
	<!-- init js -->
	<script src="{{ asset('assets/js/custom/stats/marge-beneficiaire-send.init.js') }}"></script>
{% endblock %}
